# Menghitung IQR
Q1 = df['total_amount'].quantile(0.25)
Q3 = df['total_amount'].quantile(0.75)
IQR = Q3 - Q1

# Menentukan batas
lower_bound = Q1 - 1.5 * IQR
upper_bound = Q3 + 1.5 * IQR

# Membuang outlier
df_clean = df[(df['total_amount'] >= lower_bound) & (df['total_amount'] <= upper_bound)]

print(f"Data awal: {len(df)}, Data setelah dibersihkan: {len(df_clean)}")
